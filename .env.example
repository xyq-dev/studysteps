# StudySteps local placeholders only. Copy to .env for machine-specific values.
# Do not put real secrets, tokens, production credentials, or personal data here.

NODE_ENV=development
APP_ENV=local
PORT=3000
LISTEN_HOST=127.0.0.1

# PostgreSQL placeholder. Not a production credential and not proof of isolation.
DATABASE_URL=postgresql://studysteps:studysteps@127.0.0.1:5432/studysteps

# Test auth is fail-closed unless APP_ENV=local|test AND AUTH_TEST_MODE=1.
# NODE_ENV=production always rejects this adapter.
AUTH_TEST_MODE=1
AUTH_TEST_INBOX_KEY=replace-with-a-long-random-local-key

# Independent purpose keys. Replace before any real use. These are not production secrets.
IDENTITY_LOOKUP_KEY_V1=replace-lookup-key
IDENTITY_ADVISORY_KEY_V1=replace-advisory-key
OTP_DIGEST_KEY_V1=replace-otp-key
PAIRING_DIGEST_KEY_V1=replace-pairing-key
IDENTIFIER_ENCRYPT_KEY_V1=replace-identifier-key

# Production only. Never use * or localhost here.
# ALLOWED_ORIGINS=https://app.example.invalid
