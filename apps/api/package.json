{
  "name": "@studysteps/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "build": "prisma generate --schema ../../prisma/schema.prisma && nest build",
    "typecheck": "prisma generate --schema ../../prisma/schema.prisma && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.16",
    "@nestjs/core": "11.1.16",
    "@nestjs/platform-express": "11.1.16",
    "@prisma/client": "6.19.3",
    "@studysteps/contracts": "workspace:*",
    "@studysteps/domain": "workspace:*",
    "cookie-parser": "1.4.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.16",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "pg": "^8.16.3",
    "supertest": "^7.1.4",
    "typescript": "5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "3.2.7"
  }
}
