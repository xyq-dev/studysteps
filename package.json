{
  "name": "studysteps",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10.17.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @studysteps/web --filter @studysteps/admin --filter @studysteps/api dev",
    "dev:web": "pnpm --filter @studysteps/web dev",
    "dev:admin": "pnpm --filter @studysteps/admin dev",
    "dev:api": "pnpm --filter @studysteps/api dev",
    "lint": "eslint .",
    "typecheck": "pnpm prisma:generate && pnpm --filter @studysteps/contracts --filter @studysteps/domain --filter @studysteps/ui build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @studysteps/web test:e2e",
    "build": "pnpm -r --if-present build",
    "prisma:validate": "node ./scripts/prisma-validate.mjs",
    "prisma:generate": "prisma generate",
    "worker:horizon": "node apps/api/dist/horizon-worker/main.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma"
    ]
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.9.6",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
