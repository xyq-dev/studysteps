generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  LOCKED
  DISABLED
  DELETION_PENDING
  DELETED
}

enum StudentStatus {
  ONBOARDING
  ACTIVE
  RESTRICTED
  DELETION_PENDING
  DELETED
}

enum AgeBand {
  UNDER_14
  AGE_14_TO_17
  AGE_18_PLUS
}

enum GuardianRole {
  PRIMARY_GUARDIAN
}

enum GuardianLinkStatus {
  ACTIVE
  REVOKED
}

enum SessionScope {
  GUARDIAN
  STUDENT
}

enum ChallengePurpose {
  SIGN_IN
  GUARDIAN_STEP_UP
}

model Account {
  id           String        @id @default(uuid()) @db.Uuid
  status       AccountStatus @default(ACTIVE)
  authVersion  Int           @default(1) @map("auth_version")
  version      Int           @default(1)
  lockedUntil  DateTime?     @map("locked_until") @db.Timestamptz(3)
  disabledAt   DateTime?     @map("disabled_at") @db.Timestamptz(3)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  identities   AuthIdentity[]
  links        GuardianLink[]
  createdStudents StudentProfile[] @relation("StudentCreatedBy")
  ageConfirmedStudents StudentProfile[] @relation("StudentAgeConfirmedBy")
  grantedConsents ConsentRecord[] @relation("ConsentGrantedBy")
  withdrawnConsents ConsentRecord[] @relation("ConsentWithdrawnBy")
  revokedLinks GuardianLink[] @relation("LinkRevokedBy")
  guardianSessions DeviceSession[] @relation("GuardianSessions")
  issuedStudentSessions DeviceSession[] @relation("IssuedStudentSessions")
  challenges   AuthChallenge[]
  pairings     DevicePairing[]
  createdPlans StudyPlan[] @relation("PlanCreatedBy")
  attestedPlans StudyPlan[] @relation("PlanCoCreationAttestedBy")

  @@map("accounts")
}

model AuthIdentity {
  id                   String   @id @default(uuid()) @db.Uuid
  accountId            String   @map("account_id") @db.Uuid
  kind                 String
  provider             String
  encryptedIdentifier  Bytes   @map("encrypted_identifier")
  encryptionKeyVersion String  @map("encryption_key_version")
  verifiedAt           DateTime @map("verified_at") @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  account              Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  lookups              AuthIdentityLookup[]
  challenges           AuthChallenge[]

  @@unique([id, provider, kind])
  @@unique([id, accountId, provider, kind])
  @@map("auth_identities")
}

model AuthIdentityLookup {
  id                   String       @id @default(uuid()) @db.Uuid
  authIdentityId       String       @map("auth_identity_id") @db.Uuid
  kind                 String
  provider             String
  lookupKeyVersion     String       @map("lookup_key_version")
  subjectLookupDigest  String       @map("subject_lookup_digest")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  identity             AuthIdentity @relation(fields: [authIdentityId, provider, kind], references: [id, provider, kind], onDelete: Restrict)
  challenges           AuthChallenge[] @relation("ChallengeLookupAlias")

  @@unique([provider, kind, lookupKeyVersion, subjectLookupDigest])
  @@unique([authIdentityId, lookupKeyVersion])
  @@unique([authIdentityId, provider, kind, lookupKeyVersion, subjectLookupDigest])
  @@map("auth_identity_lookups")
}

model StudentProfile {
  id                      String        @id @default(uuid()) @db.Uuid
  status                  StudentStatus @default(ONBOARDING)
  nickname                String
  avatarPresetId          String        @map("avatar_preset_id")
  ageBand                 AgeBand       @map("age_band")
  ageConfirmationSource   String        @map("age_confirmation_source")
  ageConfirmedAt          DateTime      @map("age_confirmed_at") @db.Timestamptz(3)
  ageConfirmedByAccountId String        @map("age_confirmed_by_account_id") @db.Uuid
  stageCode               String?       @map("stage_code")
  schoolSystemCode        String?       @map("school_system_code")
  gradeCode               String?       @map("grade_code")
  gradeLabel              String?       @map("grade_label")
  termCode                String?       @map("term_code")
  gradeConfigId           String?       @map("grade_config_id") @db.Uuid
  gradeConfigVersionId    String?       @map("grade_config_version_id") @db.Uuid
  timezone                String        @default("Asia/Shanghai")
  createdByAccountId      String        @map("created_by_account_id") @db.Uuid
  version                 Int           @default(1)
  restrictedAt            DateTime?     @map("restricted_at") @db.Timestamptz(3)
  deletedAt               DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy               Account       @relation("StudentCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  ageConfirmedBy          Account       @relation("StudentAgeConfirmedBy", fields: [ageConfirmedByAccountId], references: [id], onDelete: Restrict)
  links                   GuardianLink[]
  consents                ConsentRecord[]
  studentSessions         DeviceSession[]
  pairings                DevicePairing[]
  gradeConfig             GradeConfig?    @relation(fields: [gradeConfigId], references: [id], onDelete: Restrict)
  gradeConfigVersion      GradeConfigVersion? @relation("StudentGradeVersion", fields: [gradeConfigVersionId, gradeConfigId], references: [id, gradeConfigId], onDelete: Restrict)
  educationHistory        StudentEducationHistory[]
  studyPlans              StudyPlan[]

  @@map("student_profiles")
}

model GuardianLink {
  id                   String             @id @default(uuid()) @db.Uuid
  accountId            String             @map("account_id") @db.Uuid
  studentProfileId     String             @map("student_profile_id") @db.Uuid
  role                 GuardianRole       @default(PRIMARY_GUARDIAN)
  permissionSetKey     String             @default("PRIMARY_GUARDIAN_V1") @map("permission_set_key")
  status               GuardianLinkStatus @default(ACTIVE)
  activeFrom           DateTime           @default(now()) @map("active_from") @db.Timestamptz(3)
  revokedAt            DateTime?          @map("revoked_at") @db.Timestamptz(3)
  revokedByAccountId   String?            @map("revoked_by_account_id") @db.Uuid
  revocationReasonCode String?            @map("revocation_reason_code")
  version              Int                @default(1)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  account              Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  student              StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  revokedBy            Account?           @relation("LinkRevokedBy", fields: [revokedByAccountId], references: [id], onDelete: Restrict)
  consents             ConsentRecord[]
  issuedSessions       DeviceSession[]
  pairings             DevicePairing[]

  @@unique([id, studentProfileId])
  @@unique([id, studentProfileId, accountId])
  @@index([accountId, status, studentProfileId])
  @@index([studentProfileId, status])
  @@map("guardian_links")
}

model ConsentPolicy {
  id                       String                   @id @default(uuid()) @db.Uuid
  policyKey                String                   @map("policy_key")
  locale                   String
  currentDocumentVersionId String?                  @map("current_document_version_id") @db.Uuid
  version                  Int                      @default(1)
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  documents                ConsentDocumentVersion[]
  records                  ConsentRecord[]

  @@unique([policyKey, locale])
  @@map("consent_policies")
}

model ConsentDocumentVersion {
  id                     String         @id @default(uuid()) @db.Uuid
  consentPolicyId        String         @map("consent_policy_id") @db.Uuid
  version                String
  contentFormat          String         @map("content_format")
  contentBody            String         @map("content_body")
  contentDigest          String         @map("content_digest")
  scopeCanonicalJson     String         @map("scope_canonical_json")
  scopeDigest            String         @map("scope_digest")
  scopeSchemaVersion     String         @map("scope_schema_version")
  digestAlgorithmVersion String         @map("digest_algorithm_version")
  publishedAt            DateTime?      @map("published_at") @db.Timestamptz(3)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  policy                 ConsentPolicy  @relation(fields: [consentPolicyId], references: [id], onDelete: Restrict)
  records                ConsentRecord[]

  @@unique([consentPolicyId, version])
  @@unique([id, consentPolicyId])
  @@map("consent_document_versions")
}

model ConsentRecord {
  id                     String                 @id @default(uuid()) @db.Uuid
  studentProfileId       String                 @map("student_profile_id") @db.Uuid
  guardianLinkId         String                 @map("guardian_link_id") @db.Uuid
  consentPolicyId        String                 @map("consent_policy_id") @db.Uuid
  documentVersionId      String                 @map("document_version_id") @db.Uuid
  scopeSnapshot          String                 @map("scope_snapshot")
  scopeDigest            String                 @map("scope_digest")
  scopeSchemaVersion     String                 @map("scope_schema_version")
  digestAlgorithmVersion String                 @map("digest_algorithm_version")
  ageBandSnapshot        AgeBand                @map("age_band_snapshot")
  grantedByAccountId     String                 @map("granted_by_account_id") @db.Uuid
  grantedAt              DateTime               @map("granted_at") @db.Timestamptz(3)
  withdrawnByAccountId   String?                @map("withdrawn_by_account_id") @db.Uuid
  withdrawnAt            DateTime?              @map("withdrawn_at") @db.Timestamptz(3)
  withdrawalReasonCode   String?                @map("withdrawal_reason_code")
  supersededAt           DateTime?              @map("superseded_at") @db.Timestamptz(3)
  version                Int                    @default(1)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  student                StudentProfile         @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  link                   GuardianLink           @relation(fields: [guardianLinkId, studentProfileId, grantedByAccountId], references: [id, studentProfileId, accountId], onDelete: Restrict)
  policy                 ConsentPolicy          @relation(fields: [consentPolicyId], references: [id], onDelete: Restrict)
  document               ConsentDocumentVersion @relation(fields: [documentVersionId, consentPolicyId], references: [id, consentPolicyId], onDelete: Restrict)
  grantedBy              Account                @relation("ConsentGrantedBy", fields: [grantedByAccountId], references: [id], onDelete: Restrict)
  withdrawnBy            Account?               @relation("ConsentWithdrawnBy", fields: [withdrawnByAccountId], references: [id], onDelete: Restrict)

  @@map("consent_records")
}

model DeviceSession {
  id                       String         @id @default(uuid()) @db.Uuid
  scope                    SessionScope
  accountId                String?        @map("account_id") @db.Uuid
  studentProfileId         String?        @map("student_profile_id") @db.Uuid
  issuedByGuardianLinkId   String?        @map("issued_by_guardian_link_id") @db.Uuid
  issuedByAccountId        String?        @map("issued_by_account_id") @db.Uuid
  origin                   String
  credentialDigest         String         @unique @map("credential_digest")
  csrfDigest               String         @map("csrf_digest")
  accountAuthVersionAtIssue Int?          @map("account_auth_version_at_issue")
  issuerAuthVersionAtIssue Int?           @map("issuer_auth_version_at_issue")
  deviceInstallationDigest String         @map("device_installation_digest")
  deviceLabel              String?        @map("device_label")
  authenticatedAt          DateTime       @map("authenticated_at") @db.Timestamptz(3)
  stepUpVerifiedAt         DateTime?      @map("step_up_verified_at") @db.Timestamptz(3)
  lastSeenAt               DateTime?      @map("last_seen_at") @db.Timestamptz(3)
  expiresAt                DateTime       @map("expires_at") @db.Timestamptz(3)
  revokedAt                DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revocationReasonCode     String?        @map("revocation_reason_code")
  replacedBySessionId      String?        @unique @map("replaced_by_session_id") @db.Uuid
  version                  Int            @default(1)
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  account                  Account?       @relation("GuardianSessions", fields: [accountId], references: [id], onDelete: Restrict)
  student                  StudentProfile? @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  issuedByLink             GuardianLink?  @relation(fields: [issuedByGuardianLinkId, studentProfileId, issuedByAccountId], references: [id, studentProfileId, accountId], onDelete: Restrict)
  issuedByAccount          Account?       @relation("IssuedStudentSessions", fields: [issuedByAccountId], references: [id], onDelete: Restrict)
  replacedBy               DeviceSession? @relation("SessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: Restrict)
  replaces                 DeviceSession[] @relation("SessionReplacement")
  challenges               AuthChallenge[]
  createdPairings          DevicePairing[] @relation("PairingCreatedBySession")
  consumedPairings         DevicePairing[] @relation("PairingConsumedBySession")
  createdPlans             StudyPlan[] @relation("PlanCreatedBySession")

  @@unique([id, studentProfileId])
  @@unique([id, accountId])
  @@map("device_sessions")
}

/// GUARDIAN_STEP_UP rows are also checked by trigger ss_auth_challenges_step_up_bound
/// in migration 20260914170000_stp004_step_up_bound_session.
/// Parent-key CHECKs (identity/account all-or-nothing; lookup alias complete when
/// identity is stamped) live in 20260915160000_stp004_parent_keys_cycle_clock.
model AuthChallenge {
  id                         String            @id @default(uuid()) @db.Uuid
  purpose                    ChallengePurpose
  identityKind               String            @map("identity_kind")
  provider                   String
  accountId                  String?           @map("account_id") @db.Uuid
  authIdentityId             String?           @map("auth_identity_id") @db.Uuid
  boundSessionId             String?           @map("bound_session_id") @db.Uuid
  deviceInstallationDigest   String            @map("device_installation_digest")
  destinationLookupDigest    String            @map("destination_lookup_digest")
  destinationLookupKeyVersion String           @map("destination_lookup_key_version")
  encryptedDestination       Bytes?            @map("encrypted_destination")
  codeDigest                 String            @map("code_digest")
  codeDigestKeyVersion       String            @map("code_digest_key_version")
  attemptCount               Int               @default(0) @map("attempt_count")
  maxAttempts                Int               @default(5) @map("max_attempts")
  expiresAt                  DateTime          @map("expires_at") @db.Timestamptz(3)
  consumedAt                 DateTime?         @map("consumed_at") @db.Timestamptz(3)
  lockedAt                   DateTime?         @map("locked_at") @db.Timestamptz(3)
  createdAt                  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  account                    Account?          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  identity                   AuthIdentity?     @relation(fields: [authIdentityId, accountId, provider, identityKind], references: [id, accountId, provider, kind], onDelete: Restrict)
  lookup                     AuthIdentityLookup? @relation("ChallengeLookupAlias", fields: [authIdentityId, provider, identityKind, destinationLookupKeyVersion, destinationLookupDigest], references: [authIdentityId, provider, kind, lookupKeyVersion, subjectLookupDigest], onDelete: Restrict, onUpdate: Restrict)
  boundSession               DeviceSession?    @relation(fields: [boundSessionId], references: [id], onDelete: Restrict)

  @@map("auth_challenges")
}

model DevicePairing {
  id                     String         @id @default(uuid()) @db.Uuid
  studentProfileId       String         @map("student_profile_id") @db.Uuid
  issuedByGuardianLinkId String         @map("issued_by_guardian_link_id") @db.Uuid
  createdByAccountId     String         @map("created_by_account_id") @db.Uuid
  createdBySessionId     String         @map("created_by_session_id") @db.Uuid
  codeDigest             String         @map("code_digest")
  digestKeyVersion       String         @map("digest_key_version")
  attemptCount           Int            @default(0) @map("attempt_count")
  maxAttempts            Int            @default(5) @map("max_attempts")
  expiresAt              DateTime       @map("expires_at") @db.Timestamptz(3)
  consumedAt             DateTime?      @map("consumed_at") @db.Timestamptz(3)
  consumedBySessionId    String?        @unique @map("consumed_by_session_id") @db.Uuid
  revokedAt              DateTime?      @map("revoked_at") @db.Timestamptz(3)
  lockedAt               DateTime?      @map("locked_at") @db.Timestamptz(3)
  version                Int            @default(1)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  student                StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  link                   GuardianLink   @relation(fields: [issuedByGuardianLinkId, studentProfileId, createdByAccountId], references: [id, studentProfileId, accountId], onDelete: Restrict)
  createdByAccount       Account        @relation(fields: [createdByAccountId], references: [id], onDelete: Restrict)
  createdBySession       DeviceSession  @relation("PairingCreatedBySession", fields: [createdBySessionId, createdByAccountId], references: [id, accountId], onDelete: Restrict)
  consumedBySession      DeviceSession? @relation("PairingConsumedBySession", fields: [consumedBySessionId, studentProfileId], references: [id, studentProfileId], onDelete: Restrict)

  @@unique([digestKeyVersion, codeDigest])
  @@map("device_pairings")
}

model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  actorScope     String    @map("actor_scope")
  actorId        String    @map("actor_id")
  operation      String
  keyDigest      String    @map("key_digest")
  requestDigest  String    @map("request_digest")
  resourceType   String?   @map("resource_type")
  resourceId     String?   @map("resource_id")
  responseStatus Int?      @map("response_status")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)

  @@unique([actorScope, actorId, operation, keyDigest])
  @@map("idempotency_records")
}

model RateLimitBucket {
  id              String   @id @default(uuid()) @db.Uuid
  bucketKey       String   @map("bucket_key")
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)
  count           Int
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([bucketKey, windowStartedAt])
  @@map("rate_limit_buckets")
}

model GradeConfig {
  id                       String               @id @db.Uuid
  schoolSystemCode         String               @map("school_system_code")
  stageCode                String               @map("stage_code")
  gradeCode                String               @map("grade_code")
  currentVersionId         String?              @map("current_version_id") @db.Uuid
  version                  Int                  @default(1)
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  currentVersion           GradeConfigVersion?  @relation("GradeConfigCurrentVersion", fields: [currentVersionId, id], references: [id, gradeConfigId], onDelete: Restrict)
  documents                GradeConfigVersion[] @relation("GradeConfigDocumentVersions")
  students                 StudentProfile[]
  historyFrom              StudentEducationHistory[] @relation("EducationFromConfig")
  historyTo                StudentEducationHistory[] @relation("EducationToConfig")

  @@unique([schoolSystemCode, stageCode, gradeCode])
  @@map("grade_configs")
}

model GradeConfigVersion {
  id                 String      @id @db.Uuid
  gradeConfigId      String      @map("grade_config_id") @db.Uuid
  version            String
  gradeLabel         String      @map("grade_label")
  sortOrder          Int         @map("sort_order")
  nextGradeConfigId  String?     @map("next_grade_config_id") @db.Uuid
  catalogEntryKey    String?     @map("catalog_entry_key")
  allowedTermCodes   String      @map("allowed_term_codes")
  publishedAt        DateTime?   @map("published_at") @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  config             GradeConfig @relation("GradeConfigDocumentVersions", fields: [gradeConfigId], references: [id], onDelete: Restrict)
  currentOf          GradeConfig[] @relation("GradeConfigCurrentVersion")
  students           StudentProfile[] @relation("StudentGradeVersion")

  @@unique([gradeConfigId, version])
  @@unique([id, gradeConfigId])
  @@map("grade_config_versions")
}

model StudentEducationHistory {
  id                     String         @id @default(uuid()) @db.Uuid
  studentProfileId       String         @map("student_profile_id") @db.Uuid
  changeKind             String         @map("change_kind")
  fromGradeConfigId      String?        @map("from_grade_config_id") @db.Uuid
  toGradeConfigId        String?        @map("to_grade_config_id") @db.Uuid
  fromStageCode          String?        @map("from_stage_code")
  fromSchoolSystemCode   String?        @map("from_school_system_code")
  fromGradeCode          String?        @map("from_grade_code")
  fromGradeLabel         String?        @map("from_grade_label")
  fromTermCode           String?        @map("from_term_code")
  toStageCode            String?        @map("to_stage_code")
  toSchoolSystemCode     String?        @map("to_school_system_code")
  toGradeCode            String?        @map("to_grade_code")
  toGradeLabel           String?        @map("to_grade_label")
  toTermCode             String?        @map("to_term_code")
  actorAccountId         String         @map("actor_account_id") @db.Uuid
  effectiveLocalDate     String         @map("effective_local_date")
  timezoneSnapshot       String         @map("timezone_snapshot")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  student                StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  fromConfig             GradeConfig?   @relation("EducationFromConfig", fields: [fromGradeConfigId], references: [id], onDelete: Restrict)
  toConfig               GradeConfig?   @relation("EducationToConfig", fields: [toGradeConfigId], references: [id], onDelete: Restrict)

  @@index([studentProfileId, createdAt])
  @@map("student_education_history")
}

model Subject {
  id        String   @id @db.Uuid
  code      String   @unique
  label     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("subjects")
}

model PlanTemplateVersion {
  id               String    @id @db.Uuid
  templateKey      String    @map("template_key")
  version          String
  catalogEntryKey  String    @map("catalog_entry_key")
  kind             String
  title            String
  summary          String
  contentJson      String    @map("content_json")
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  importedPlans    StudyPlan[]

  @@unique([templateKey, version])
  @@index([catalogEntryKey, kind])
  @@map("plan_template_versions")
}

model StudyPlan {
  id                          String               @id @default(uuid()) @db.Uuid
  studentProfileId            String               @map("student_profile_id") @db.Uuid
  status                      String               @default("ACTIVE")
  origin                      String
  createdByAccountId          String?              @map("created_by_account_id") @db.Uuid
  createdBySessionId          String?              @map("created_by_session_id") @db.Uuid
  coCreationAttestedAt        DateTime?            @map("co_creation_attested_at") @db.Timestamptz(3)
  coCreationAttestedByAccountId String?            @map("co_creation_attested_by_account_id") @db.Uuid
  studentConfirmedAt          DateTime?            @map("student_confirmed_at") @db.Timestamptz(3)
  sourceTemplateVersionId     String?              @map("source_template_version_id") @db.Uuid
  importedContentJson         String               @map("imported_content_json")
  timezoneSnapshot            String               @map("timezone_snapshot")
  version                     Int                  @default(1)
  createdAt                   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  student                     StudentProfile       @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  createdByAccount            Account?             @relation("PlanCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  createdBySession            DeviceSession?       @relation("PlanCreatedBySession", fields: [createdBySessionId], references: [id], onDelete: Restrict)
  attestedBy                  Account?             @relation("PlanCoCreationAttestedBy", fields: [coCreationAttestedByAccountId], references: [id], onDelete: Restrict)
  sourceTemplate              PlanTemplateVersion? @relation(fields: [sourceTemplateVersionId], references: [id], onDelete: Restrict)
  series                      TaskSeries[]
  adjustments                 PlanAdjustment[]

  @@index([studentProfileId, status])
  @@map("study_plans")
}

model TaskSeries {
  id                    String           @id @default(uuid()) @db.Uuid
  planId                String           @map("plan_id") @db.Uuid
  name                  String
  subject               String
  completionStandard    String           @map("completion_standard")
  durationMinutes       Int?             @map("duration_minutes")
  stepsJson             String           @default("[]") @map("steps_json")
  repeatKind            String           @map("repeat_kind")
  weekdaysJson          String?          @map("weekdays_json")
  startLocalDate        String           @map("start_local_date")
  endLocalDate          String?          @map("end_local_date")
  ongoing               Boolean          @default(false)
  effectiveFromLocalDate String          @map("effective_from_local_date")
  effectiveToLocalDate  String?          @map("effective_to_local_date")
  version               Int              @default(1)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  plan                  StudyPlan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  occurrences           TaskOccurrence[]
  adjustments           PlanAdjustment[]
  revisions             TaskSeriesRevision[]

  @@index([planId])
  @@map("task_series")
}

model TaskSeriesRevision {
  taskSeriesId               String   @map("task_series_id") @db.Uuid
  revisionNo                 Int      @map("revision_no")
  changeKind                 String   @map("change_kind")
  effectiveFromOccurrenceKey String   @map("effective_from_occurrence_key")
  name                       String?
  subject                    String?
  completionStandard         String?  @map("completion_standard")
  durationMinutes            Int?     @map("duration_minutes")
  stepsJson                  String?  @map("steps_json")
  repeatKind                 String?  @map("repeat_kind")
  weekdaysJson               String?  @map("weekdays_json")
  endLocalDate               String?  @map("end_local_date")
  ongoing                    Boolean?
  sourceAdjustmentId         String?  @unique @map("source_adjustment_id") @db.Uuid
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  series                     TaskSeries @relation(fields: [taskSeriesId], references: [id], onDelete: Restrict)
  sourceAdjustment           PlanAdjustment? @relation("RevisionSourceAdjustment", fields: [sourceAdjustmentId], references: [id], onDelete: Restrict)
  contentOccurrences         TaskOccurrence[] @relation("OccurrenceContentRevision")
  scheduleOccurrences        TaskOccurrence[] @relation("OccurrenceScheduleRevision")

  @@id([taskSeriesId, revisionNo])
  @@index([taskSeriesId, changeKind, effectiveFromOccurrenceKey, revisionNo(sort: Desc)])
  @@map("task_series_revisions")
}

model TaskOccurrence {
  id                     String           @id @default(uuid()) @db.Uuid
  seriesId               String           @map("series_id") @db.Uuid
  occurrenceKey          String           @map("occurrence_key")
  originalLocalDate      String           @map("original_local_date")
  scheduledLocalDate     String           @map("scheduled_local_date")
  timezoneSnapshot       String           @map("timezone_snapshot")
  status                 String           @default("PLANNED")
  cancelReason           String?          @map("cancel_reason")
  nameSnapshot           String           @map("name_snapshot")
  subjectSnapshot        String           @map("subject_snapshot")
  completionStandardSnapshot String       @map("completion_standard_snapshot")
  durationMinutesSnapshot Int?            @map("duration_minutes_snapshot")
  stepsSnapshotJson      String           @map("steps_snapshot_json")
  gradeConfigId          String           @map("grade_config_id") @db.Uuid
  gradeConfigVersionId   String           @map("grade_config_version_id") @db.Uuid
  stageCodeSnapshot      String           @map("stage_code_snapshot")
  schoolSystemCodeSnapshot String         @map("school_system_code_snapshot")
  gradeCodeSnapshot      String           @map("grade_code_snapshot")
  gradeLabelSnapshot     String           @map("grade_label_snapshot")
  termCodeSnapshot       String           @map("term_code_snapshot")
  catalogEntryKeySnapshot String          @map("catalog_entry_key_snapshot")
  sourceOccurrenceId     String?          @map("source_occurrence_id") @db.Uuid
  version                Int              @default(1)
  contentRevisionNo      Int              @default(1) @map("content_revision_no")
  scheduleRevisionNo     Int              @default(1) @map("schedule_revision_no")
  contentExceptionAdjustmentId String?    @map("content_exception_adjustment_id") @db.Uuid
  scheduleExceptionAdjustmentId String?   @map("schedule_exception_adjustment_id") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  series                 TaskSeries       @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  contentRevision        TaskSeriesRevision @relation("OccurrenceContentRevision", fields: [seriesId, contentRevisionNo], references: [taskSeriesId, revisionNo], onDelete: Restrict)
  scheduleRevision       TaskSeriesRevision @relation("OccurrenceScheduleRevision", fields: [seriesId, scheduleRevisionNo], references: [taskSeriesId, revisionNo], onDelete: Restrict)
  contentException       PlanAdjustment?  @relation("OccurrenceContentException", fields: [contentExceptionAdjustmentId], references: [id], onDelete: Restrict)
  scheduleException      PlanAdjustment?  @relation("OccurrenceScheduleException", fields: [scheduleExceptionAdjustmentId], references: [id], onDelete: Restrict)
  sourceOccurrence       TaskOccurrence?  @relation("OccurrenceSplit", fields: [sourceOccurrenceId], references: [id], onDelete: Restrict)
  splitFrom              TaskOccurrence[] @relation("OccurrenceSplit")
  adjustments            PlanAdjustment[]

  @@unique([seriesId, occurrenceKey])
  @@unique([seriesId, scheduledLocalDate])
  @@index([scheduledLocalDate])
  @@index([sourceOccurrenceId])
  @@index([seriesId, contentRevisionNo])
  @@index([seriesId, scheduleRevisionNo])
  @@index([contentExceptionAdjustmentId])
  @@index([scheduleExceptionAdjustmentId])
  @@map("task_occurrences")
}

model PlanAdjustment {
  id              String          @id @default(uuid()) @db.Uuid
  planId          String          @map("plan_id") @db.Uuid
  seriesId        String?         @map("series_id") @db.Uuid
  occurrenceId    String?         @map("occurrence_id") @db.Uuid
  reasonCode      String          @map("reason_code")
  payloadJson     String          @map("payload_json")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  plan            StudyPlan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  series          TaskSeries?     @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  occurrence      TaskOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  futureRevisions TaskSeriesRevision[] @relation("RevisionSourceAdjustment")
  contentExceptions TaskOccurrence[] @relation("OccurrenceContentException")
  scheduleExceptions TaskOccurrence[] @relation("OccurrenceScheduleException")

  @@index([planId, createdAt])
  @@index([seriesId])
  @@index([occurrenceId])
  @@map("plan_adjustments")
}
